# mosa.mx — https, sin www, barra final
RewriteEngine On
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.mosa\.mx [NC]
RewriteRule ^(.*)$ https://mosa.mx/$1 [R=301,L]
RewriteRule ^$ /guadalajara/lluvias/ [R=301,L]
RewriteCond %{REQUEST_URI} !\.(xml|txt|html?|css|js|jpe?g|png|webp|svg|ico|pdf)$
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^(.*[^/])$ /$1/ [R=301,L]
ErrorDocument 404 /404.html
DirectoryIndex index.html
