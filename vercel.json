{
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/(.*)\\.webp",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/closet-capsula/piel-morena/*",
      "destination": "/colores/piel-morena/",
      "permanent": true
    },
    {
      "source": "/cuerpo/*",
      "destination": "/colores/",
      "permanent": true
    },
    {
      "source": "/altura/*",
      "destination": "/colores/",
      "permanent": true
    },
    {
      "source": "/edad/*",
      "destination": "/colores/",
      "permanent": true
    },
    {
      "source": "/closet-capsula/*",
      "destination": "/colores/",
      "permanent": true
    },
    {
      "source": "/guadalajara/lluvias/*",
      "destination": "/colores/",
      "permanent": true
    }
  ]
}
